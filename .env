TLS_CERT_PATH=/usr/local/share/ca-certificates/tls.crt
TLS_JKS_PATH=/usr/local/share/ca-certificates/tls.jks
TLS_KEY_PATH=/usr/local/share/ca-certificates/tls.key

DB_HOST=postgres
DB_PASSWORD=password
DB_PORT=5432
DB_USERNAME=postgres

# https://openfga.dev/docs/getting-started/setup-openfga/configure-openfga
OPENFGA_API_URL=https://openfga:8080
OPENFGA_DATASTORE_ENGINE=postgres
OPENFGA_DB_HOST=${DB_HOST}
OPENFGA_DB_NAME=openfga
OPENFGA_DB_PASSWORD=${DB_PASSWORD}
OPENFGA_DB_PORT=${DB_PORT}
OPENFGA_DB_USERNAME=${DB_USERNAME}
OPENFGA_HTTP_TLS_ENABLED=true
OPENFGA_HTTP_TLS_CERT=${TLS_CERT_PATH}
OPENFGA_HTTP_TLS_KEY=${TLS_KEY_PATH}
OPENFGA_LOG_FORMAT=json
OPENFGA_LOG_LEVEL=warn
OPENFGA_VERSION=1.8.11
OPENFGA_CLI_VERSION=0.6.6
# Must be declared after the variables it references.
OPENFGA_DATASTORE_URI=postgres://${OPENFGA_DB_USERNAME}:${OPENFGA_DB_PASSWORD}@${OPENFGA_DB_HOST}:${OPENFGA_DB_PORT}/${OPENFGA_DB_NAME}

# See https://github.com/openfga/cli?tab=readme-ov-file#usage
FGA_API_URL=${OPENFGA_API_URL}
FGA_HTTP_TLS_CERT=${TLS_CERT_PATH}
FGA_HTTP_TLS_KEY=${TLS_KEY_PATH}